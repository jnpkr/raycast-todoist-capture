{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "todoist-capture",
  "title": "Todoist Capture",
  "description": "Capture the current macOS context into a Todoist Quick Add draft",
  "icon": "extension-icon.png",
  "author": "jon",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "capture-to-todoist",
      "title": "Capture to Todoist",
      "description": "Open a Todoist draft from the current context",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.24",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run"
  },
  "packageManager": "pnpm@11.20.0"
}
